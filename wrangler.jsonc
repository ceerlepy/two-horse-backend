{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "two-horse-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],


  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "two-horse-db",
      "database_id": "f54d0d64-93f8-462f-8ce9-e38e139f10c9",
      "migrations_dir": "migrations"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "browser": {
    "binding": "BROWSER"
  },

  "vars": {
    "APP_NAME": "Two Horse Backend",
    "APP_VERSION": "0.1.0"
  },

  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
